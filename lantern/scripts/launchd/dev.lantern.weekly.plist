<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-schedule.sh fills in __WEEKLY__ and __HOME__ and loads it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lantern.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WEEKLY__</string>
  </array>
  <!-- Monday 07:00 local; if the Mac slept through it, launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <!-- Hourly retry and at login: weekly.sh exits at once unless the week still needs a note. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Lantern/weekly.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Lantern/weekly.log</string>
</dict>
</plist>
