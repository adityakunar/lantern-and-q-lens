<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-auto-fetch.sh fills in __APP__ and __HOME__ and loads it.
     It starts the Curator Fetch app, which runs scripts/auto-fetch.sh with its own permission
     to write into the vault's iCloud folder. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lantern.curator-fetch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__</string>
  </array>
  <!-- Every hour and at login; launchd also runs a missed interval after wake. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Lantern/curator-fetch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Lantern/curator-fetch.log</string>
</dict>
</plist>
